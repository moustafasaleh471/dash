function buildModel(objects){
 const rm=readmeMap(objects),sources=objects['01_SOURCES']||[],meta=objects['02_REPORT_META']||[],prM=objects['03_PR_MONTHLY']||[],prQ=objects['04_PR_QUARTERLY']||[],dept=objects['05_PR_DEPARTMENT']||[],deptPct=objects['06_PR_DEPT_PCT']||[],savM=objects['07_SAVINGS_MONTHLY']||[],savQ=objects['08_SAVINGS_QUARTERLY']||[],valid=objects['11_DATA_VALIDATION']||[];
 
 const periodMap=new Map();
 prQ.forEach(r=>{const k=periodKey(r.year,r.quarter);if(k&&!periodMap.has(k))periodMap.set(k,{year:Number(r.year),quarter:String(r.quarter).toUpperCase()});});
 const periods=[...periodMap.values()].sort((a,b)=>periodKey(a.year,a.quarter)-periodKey(b.year,b.quarter));
 const latest=periods.at(-1)||{year:2026,quarter:'ALL'};
 const earliest=periods[0]||latest;

 const qGroups=new Map();
 prQ.forEach(r=>{
   const k=periodKey(r.year,r.quarter);
   if(!qGroups.has(k))qGroups.set(k,{year:Number(r.year),quarter:String(r.quarter).toUpperCase(),emergency:0,normal:0});
   const g=qGroups.get(k);
   const t=String(r.pr_type||'').toUpperCase();
   if(t==='EMERGENCY')g.emergency+=num(r.reported_pr_count)||0;
   if(t==='NORMAL')g.normal+=num(r.reported_pr_count)||0;
 });
 const quarterly=[...qGroups.values()].sort((a,b)=>periodKey(a.year,a.quarter)-periodKey(b.year,b.quarter)).map((g,i,arr)=>{
   const total=(g.emergency||0)+(g.normal||0);
   const prev=i?arr[i-1]:null;
   return {...g,total,change:prev?total-prev.total:null,changePct:prev?changePct(total,prev.total):null};
 });

 const mGroups=new Map();
 prM.forEach(r=>{
   const key=String(r.month||'');
   if(!mGroups.has(key))mGroups.set(key,{year:Number(r.year),month_number:Number(r.month_number),month:r.month,emergency:0,normal:0});
   const g=mGroups.get(key);
   const t=String(r.pr_type||'').toUpperCase();
   if(t==='EMERGENCY')g.emergency+=num(r.pr_count)||0;
   if(t==='NORMAL')g.normal+=num(r.pr_count)||0;
 });
 const monthlyPR=[...mGroups.values()].sort((a,b)=>monthIndex(a.month) - monthIndex(b.month)).map(g=>({...g,total:(g.emergency||0)+(g.normal||0)}));

 const deptMapAgg = new Map();
 dept.forEach(r=>{
   const dName = r.department;
   if(!deptMapAgg.has(dName)) deptMapAgg.set(dName, {department: dName, emergency:0, normal:0, total:0});
   const item = deptMapAgg.get(dName);
   item.emergency += num(r.emergency_count)||0;
   item.normal += num(r.normal_count)||0;
   item.total += num(r.reported_total) || (num(r.emergency_count)||0) + (num(r.normal_count)||0);
 });
 const deptRows=[...deptMapAgg.values()].map(d=>{
   const ep = d.total ? (d.emergency/d.total) : 0;
   const np = d.total ? (d.normal/d.total) : 0;
   return {...d, emergencyPct: ep, normalPct: np};
 });
 const deptGrand=sum(deptRows.map(r=>r.total));
 deptRows.forEach(r=>r.share=deptGrand?r.total/deptGrand:null);
 deptRows.sort((a,b)=>b.total-a.total);

 const savingsMonthly=savM.map(r=>({...r,variation:num(r.variation),reported_cost_saving_pct:num(r.reported_cost_saving_pct),calculated_cost_saving_pct:num(r.calculated_cost_saving_pct)})).sort((a,b)=>monthIndex(a.month) - monthIndex(b.month));
 const savingsQuarterly=savQ.map(r=>({...r,reported_variation:num(r.reported_variation),reported_cost_saving_pct:num(r.reported_cost_saving_pct),calculated_variation:num(r.calculated_variation),calculated_cost_saving_pct:num(r.calculated_cost_saving_pct)})).sort((a,b)=>periodKey(a.year,a.quarter)-periodKey(b.year,b.quarter));

 const totalEmergency = sum(deptRows.map(r=>r.emergency));
 const totalNormal = sum(deptRows.map(r=>r.normal));
 const totalPR = totalEmergency + totalNormal;
 const totalVariation = sum(savingsMonthly.map(r=>r.variation));
 const totalPriceOffer = sum(savingsMonthly.map(r=>r.total_price_offer));
 const totalSavingPct = totalPriceOffer > 0 ? (totalVariation / totalPriceOffer) : 0;

 const currentQ = {
   total: totalPR,
   emergency: totalEmergency,
   normal: totalNormal,
   year: periods.length === 1 ? periods[0].year : 'Active',
   quarter: periods.length === 1 ? periods[0].quarter : 'Scope'
 };

 const currentSav = {
   reported_variation: totalVariation,
   reported_cost_saving_pct: totalSavingPct,
   calculated_cost_saving_pct: totalSavingPct,
   currency: 'EGP',
   year: currentQ.year,
   quarter: currentQ.quarter
 };

 const counts={pass:valid.filter(r=>String(r.status||'').toUpperCase()==='PASS').length,warning:valid.filter(r=>String(r.status||'').toUpperCase()==='WARNING').length,fail:valid.filter(r=>String(r.status||'').toUpperCase()==='FAIL').length,total:valid.length};

 const activeUnitName = document.getElementById('heroBusinessUnit')?.textContent?.trim();

 return {rm,sources,meta,quarterly,monthlyPR,deptRows,savingsMonthly,savingsQuarterly,currentQ,currentSav,currentEmergencyPct:totalPR?(totalEmergency/totalPR):0,currentNormalPct:totalPR?(totalNormal/totalPR):0,latest,earliest,reportPeriod:earliest.year&&latest.year?(periodLabel(earliest.year,earliest.quarter)+' — '+periodLabel(latest.year,latest.quarter)):'All Active Records',businessUnit:(activeUnitName && activeUnitName!=='—')?activeUnitName:(meta[0]?.business_unit||'Purchase Department'),currency:APP.currencyOverride||currentSav.currency||rm.Currency||'EGP',valid,validationCounts:counts};
}

