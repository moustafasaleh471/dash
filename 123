function esc(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}
function num(v){if(v===null||v===undefined||v==='')return null;const n=Number(v);return Number.isFinite(n)?n:null;}
function fmtInt(v){const n=num(v);return n===null?'—':Math.round(n).toLocaleString('en-US');}
function fmtMoney(v,currency='EGP'){const n=num(v);return n===null?'—':esc(currency||'EGP')+' '+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fmtPct(v,d=2){const n=num(v);return n===null?'—':(n*100).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d})+'%';}
function periodKey(y,q){const m=String(q??'').match(/([1-4])/);return (Number(y)||0)*10+(m?Number(m[1]):0);}
function periodLabel(y,q){return q&&y?String(q).toUpperCase()+' '+y:'—';}
function changePct(c,p){const cur=num(c),prv=num(p);if(cur===null||prv===null||prv===0)return null;return (cur-prv)/Math.abs(prv);}
function fmtDateTime(d){if(!(d instanceof Date)||Number.isNaN(d.getTime()))return '—';return d.toLocaleString('en-GB',{year:'numeric',month:'short',day:'2-digit',hour:'2-digit',minute:'2-digit'});}
function matrixToObjects(matrix){if(!Array.isArray(matrix)||!matrix.length)return[];const headers=(matrix[0]||[]).map(x=>String(x??'').trim());return matrix.slice(1).filter(r=>Array.isArray(r)&&r.some(v=>v!==null&&v!==undefined&&v!=='')).map(r=>{const o={};headers.forEach((h,i)=>{if(h)o[h]=r[i]??null});return o;});}
function objectsFromSheets(sheets){const out={};Object.entries(sheets||{}).forEach(([name,m])=>out[name]=matrixToObjects(m));return out;}
function readmeMap(objects){const m={};(objects['00_README']||[]).forEach(r=>{if(r.Field)m[String(r.Field)]=r.Value});return m;}
function unique(arr){return [...new Set(arr.filter(v=>v!==null&&v!==undefined&&v!==''))];}
function sum(vals){return vals.reduce((a,v)=>a+(num(v)||0),0);}

async function parseXlsxArrayBuffer(buf){
  if(window.XLSX){
    const wb=XLSX.read(buf,{type:'array'});
    const sheets={};
    wb.SheetNames.forEach(n=>{
      sheets[n]=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,defval:null});
    });
    return sheets;
  }
  throw new Error("XLSX engine library not available");
}

function extractRawRowsFromDataInput(matrix, fileName){
  if(!matrix || !matrix.length) return [];
  const headers=(matrix[0]||[]).map(h=>String(h||'').trim());
  APP.detectedColumns = headers.filter(h=>h.length>0);
  const lowerHeaders=headers.map(h=>h.toLowerCase());
  const col=(fn)=>lowerHeaders.findIndex(fn);

  const idxDate=col(h=>h.includes('date')||h.includes('تاريخ'));
  const idxName=col(h=>h==='name'||h.includes('اسم')||h.includes('employee')||h.includes('موظف'));
  const idxDept=col(h=>h.includes('dept')||h.includes('department')||h.includes('قسم')||h.includes('ادارة'));
  const idxType=col(h=>h.includes('type')||h.includes('نوع'));
  const idxCount=col(h=>h.includes('count')||h.includes('qty')||h.includes('quantity')||h.includes('عدد')||h.includes('كمية'));
  const idxPrice=col(h=>h.includes('price_offer')||h.includes('price')||h.includes('offer')||h.includes('amount')||h.includes('value')||h.includes('cost')||h.includes('total')||h.includes('سعر')||h.includes('عرض')||h.includes('قيمة')||h.includes('مبلغ'));
  const idxNeg=col(h=>h.includes('negotiat')||h.includes('after')||h.includes('تفاوض')||h.includes('نهائي'));
  const idxSrc=col(h=>h.includes('source')||h.includes('مصدر'));
  const idxNotes=col(h=>h.includes('note')||h.includes('ملاحظ')||h.includes('reason')||h.includes('وصف'));

  const raw=[];
  for(let i=1;i<matrix.length;i++){
    const r=matrix[i];
    if(!r||!r.some(v=>v!==null&&v!==''))continue;
    let d=parseDateVal(r[idxDate]);
    if(!d||isNaN(d.getTime())) d=new Date(2026, 3, 1);

    const year=d.getFullYear();
    const monthNum=d.getMonth()+1;
    const month=d.toLocaleString('en-US',{month:'short'});
    const quarter='Q'+Math.ceil(monthNum/3);
    const name=idxName!==-1 ? String(r[idxName]||'General').trim() : 'General';
    const dept=idxDept!==-1 ? String(r[idxDept]||'General').trim() : (idxName!==-1 ? name : 'General');
    let prType=String(r[idxType]||'NORMAL').trim().toUpperCase();
    if(prType.includes('EMERG')||prType.includes('طارئ')) prType='EMERGENCY'; else prType='NORMAL';
    const count=Number(r[idxCount])||1;
    const price=Number(r[idxPrice])||0;
    const neg=Number(r[idxNeg])||price;
    const sourceId=String(r[idxSrc]||'SRC001').trim();
    const noteText=idxNotes!==-1 ? String(r[idxNotes]||'—').trim() : 'Standard requisition';
    const formattedDate = formatExcelDate(r[idxDate]);

    const rowObj = { dateStr: formattedDate, year, quarter, monthNum, month, name, dept, prType, count, price, neg, sourceId, noteText, fileName };
    headers.forEach((h, colIdx)=>{
      if(h) rowObj[h] = r[colIdx];
    });

    raw.push(rowObj);
  }
  return raw;
}

