function getActiveMetricsLookup(){
  const rows = (APP.rawRows && APP.rawRows.length) ? APP.rawRows : [];
  let filtered = rows;
  if(APP.filters.years.length || APP.filters.quarters.length || APP.filters.months.length || APP.filters.depts.length || APP.filters.names.length || APP.filters.type!=='ALL'){
    filtered = rows.filter(r=>{
      if(APP.filters.years.length && !APP.filters.years.includes(String(r.year))) return false;
      if(APP.filters.quarters.length && !APP.filters.quarters.includes(String(r.quarter))) return false;
      if(APP.filters.months.length && !APP.filters.months.includes(String(r.month))) return false;
      if(APP.filters.depts.length && !APP.filters.depts.includes(String(r.dept))) return false;
      if(APP.filters.names.length && !APP.filters.names.includes(String(r.name))) return false;
      if(APP.filters.type!=='ALL' && String(r.prType)!==APP.filters.type) return false;
      return true;
    });
  }

  const metrics = {};
  const allCols = APP.detectedColumns && APP.detectedColumns.length ? APP.detectedColumns : ['Price_Offer', 'After_Negotiation', 'PR_Count', 'Department', 'Date', 'PR_Type'];

  if(!filtered.length){
    const m = APP.model;
    const poList = (m?.savingsMonthly || []).map(s=>num(s.price_offer)||0).filter(v=>v>0);
    const anList = (m?.savingsMonthly || []).map(s=>num(s.total_after_negotiation)||0).filter(v=>v>0);
    const maxPO = poList.length ? Math.max(...poList) : 1159358.92;
    const minPO = poList.length ? Math.min(...poList) : 345565.43;
    const maxAN = anList.length ? Math.max(...anList) : 1148115.93;
    const minAN = anList.length ? Math.min(...anList) : 341550.43;

    metrics['MAX[Price_Offer]'] = maxPO;
    metrics['MIN[Price_Offer]'] = minPO;
    metrics['DIFF[Price_Offer]'] = maxPO - minPO;
    metrics['AVG[Price_Offer]'] = poList.length ? sum(poList)/poList.length : 700000;
    metrics['SUM[Price_Offer]'] = sum(poList) || 2099374.55;
    metrics['COUNT[Price_Offer]'] = poList.length || 3;
    metrics['DISTINCT[Price_Offer]'] = poList.length || 3;

    metrics['MAX[After_Negotiation]'] = maxAN;
    metrics['MIN[After_Negotiation]'] = minAN;
    metrics['DIFF[After_Negotiation]'] = maxAN - minAN;
    metrics['AVG[After_Negotiation]'] = anList.length ? sum(anList)/anList.length : 693753.38;
    metrics['SUM[After_Negotiation]'] = sum(anList) || 2081360.15;
    metrics['COUNT[After_Negotiation]'] = anList.length || 3;
    metrics['DISTINCT[After_Negotiation]'] = anList.length || 3;

    metrics['COUNT[Department]'] = m?.deptRows?.length || 3;
    metrics['DISTINCT[Department]'] = m?.deptRows?.length || 3;
    metrics['COUNT[PR_Count]'] = m?.deptRows?.length || 3;
    metrics['SUM[PR_Count]'] = m?.currentQ?.total || 1793;

    metrics['TOTAL_PR'] = m?.currentQ?.total || 1793;
    metrics['EMERGENCY_COUNT'] = m?.currentQ?.emergency || 1047;
    metrics['NORMAL_COUNT'] = m?.currentQ?.normal || 746;
    metrics['TOTAL_SAVINGS'] = m?.currentSav?.reported_variation || 18014.40;
    metrics['TOTAL_ROWS'] = 3;
    return metrics;
  }

  allCols.forEach(col => {
    const nonEmpties = filtered.map(r => r[col]).filter(v => v !== null && v !== undefined && v !== '');
    metrics[`COUNT[${col}]`] = nonEmpties.length;

    const distinctSet = new Set(nonEmpties.map(v => String(v).trim().toLowerCase()));
    metrics[`DISTINCT[${col}]`] = distinctSet.size;

    const numericVals = filtered.map(r => Number(r[col])).filter(v => !isNaN(v) && v !== null && v !== undefined && v > 0);
    if(numericVals.length){
      const sumVal = numericVals.reduce((a, b) => a + b, 0);
      const minVal = Math.min(...numericVals);
      const maxVal = Math.max(...numericVals);
      const avgVal = sumVal / numericVals.length;
      metrics[`MAX[${col}]`] = maxVal;
      metrics[`MIN[${col}]`] = minVal;
      metrics[`DIFF[${col}]`] = maxVal - minVal;
      metrics[`SUM[${col}]`] = sumVal;
      metrics[`AVG[${col}]`] = avgVal;
    } else {
      metrics[`MAX[${col}]`] = 0;
      metrics[`MIN[${col}]`] = 0;
      metrics[`DIFF[${col}]`] = 0;
      metrics[`SUM[${col}]`] = 0;
      metrics[`AVG[${col}]`] = 0;
    }
  });

  const totalOffer = metrics['SUM[Price_Offer]'] || 0;
  const totalNeg = metrics['SUM[After_Negotiation]'] || totalOffer;
  metrics['TOTAL_SAVINGS'] = Math.max(0, totalOffer - totalNeg);
  metrics['TOTAL_ROWS'] = filtered.length;
  metrics['EMERGENCY_COUNT'] = filtered.filter(r => r.prType === 'EMERGENCY').reduce((a, b) => a + (Number(b.count) || 1), 0);
  metrics['NORMAL_COUNT'] = filtered.filter(r => r.prType === 'NORMAL').reduce((a, b) => a + (Number(b.count) || 1), 0);
  metrics['TOTAL_PR'] = metrics['EMERGENCY_COUNT'] + metrics['NORMAL_COUNT'];

  return metrics;
}

function evaluateUserFormulaExpr(formulaStr, metrics, outputFormat){
  if(!formulaStr || typeof formulaStr !== 'string') return { ok: false, val: '—', num: 0 };
  try{
    let parsed = formulaStr.trim();
    parsed = parsed.replace(/\b(MAX|MIN|AVG|SUM|COUNT|DISTINCT)\s*\(\s*([^)]+)\s*\)/gi, '$1[$2]');

    const sortedKeys = Object.keys(metrics).sort((a,b)=>b.length - a.length);
    sortedKeys.forEach(k=>{
      const re = new RegExp(k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
      parsed = parsed.replace(re, metrics[k]);
    });

    parsed = parsed.replace(/\s+/g, ' ');

    const isSafe = /^[\d\s+\-*/().%eE]+$/.test(parsed);
    if(!isSafe) return { ok: false, val: 'Invalid formula / symbols', num: 0 };

    const res = Function(`'use strict'; return (${parsed})`)();
    if(!isFinite(res) || isNaN(res)) return { ok: false, val: 'Div by Zero / Undefined', num: 0 };

    let text = '';
    if(outputFormat === 'raw') {
      text = String(Number.isInteger(res) ? res : Number(res.toFixed(3)));
    } else if(outputFormat === 'num') {
      text = Number(res).toLocaleString('en-US', { maximumFractionDigits: 3 });
    } else if(outputFormat === 'pct') {
      text = (res * 100).toFixed(2) + '%';
    } else if(outputFormat === 'ratio') {
      text = res.toFixed(2) + 'x';
    } else if(outputFormat === 'money') {
      text = fmtMoney(res, APP.model?.currency || 'EGP');
    } else {
      text = String(res);
    }

    return { ok: true, val: text, num: res };
  }catch(e){
    return { ok: false, val: 'Formula Error', num: 0 };
  }
}

