/* ---------------- GENERIC WORKBOOK MODE ---------------- */
let GEN_POINTS=[];
const GEN_SECTIONS={
 '03':{title:'Key KPI Circular Analysis',target:'circular-analysis'},
 '04':{title:'Volume / Trend Analysis',target:'pr-trend'},
 '05':{title:'Category Comparison',target:'emergency-normal'},
 '06':{title:'Entity & Group Breakdown',target:'department-analysis'},
 '07':{title:'Entity Volume Ranking',target:'department-ranking'},
 '08':{title:'Value / Performance Analysis',target:'cost-saving'},
 '09':{title:'Source-by-Source Analysis',target:'source-analysis'}
};
function genEsc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function genNum(v){if(v===null||v===undefined||v==='')return null;if(typeof v==='number'&&Number.isFinite(v))return v;let x=String(v).replace(/,/g,'').replace(/%/g,'').trim();if(!x)return null;let n=Number(x);return Number.isFinite(n)?n:null;}
function genNumeric(headers,rows){return headers.filter(h=>rows.some(r=>genNum(r[h])!==null)&&!genDateLike(h,rows));}
function genDateLike(h,rows){let ok=0,total=0;rows.slice(0,80).forEach(r=>{let v=r[h];if(v===null||v==='')return;total++;if(v instanceof Date||/^\d{4}[-\/]\d{1,2}/.test(String(v))||/^\d{1,2}[-\/]\d{1,2}[-\/]\d{2,4}/.test(String(v))||/month|date|time|period|year/i.test(h))ok++;});return total>0&&ok/total>.45;}
function genCategorical(headers,rows){const nums=genNumeric(headers,rows);return headers.filter(h=>!nums.includes(h)||genDateLike(h,rows));}
function genDefaultGroup(headers,rows){return genCategorical(headers,rows)[0]||'';}
function genDefaultValue(headers,rows,col){if(col&&!genDateLike(col,rows)&&rows.some(r=>genNum(r[col])!==null))return col;return genNumeric(headers,rows)[0]||'';}
function genOptions(arr,sel){return arr.map(h=>`<option value="${genEsc(h)}" ${h===sel?'selected':''}>${genEsc(h)}</option>`).join('');}
function genAggregate(rows,value,agg){if(agg==='count')return rows.length;let ns=rows.map(r=>genNum(r[value])).filter(v=>v!==null);if(!ns.length)return 0;if(agg==='avg')return ns.reduce((a,b)=>a+b,0)/ns.length;return ns.reduce((a,b)=>a+b,0);}
const GEN_DATE_FORMATS=[['ymd','YYYY-MM-DD'],['dmy','DD/MM/YYYY'],['mdy','MM/DD/YYYY'],['monY','Mon YYYY'],['mon','Month Name'],['qy','Quarter'],['y','Year']];
function genFormatDateLabel(raw,fmt){
  const d=parseDateVal(raw);
  if(!d||isNaN(d.getTime()))return String(raw??'Blank');
  const pad=n=>String(n).padStart(2,'0');
  const months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  switch(fmt){
    case 'dmy':return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()}`;
    case 'mdy':return `${pad(d.getMonth()+1)}/${pad(d.getDate())}/${d.getFullYear()}`;
    case 'monY':return `${months[d.getMonth()]} ${d.getFullYear()}`;
    case 'mon':return months[d.getMonth()];
    case 'qy':return `Q${Math.floor(d.getMonth()/3)+1} ${d.getFullYear()}`;
    case 'y':return String(d.getFullYear());
    case 'ymd':default:return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
  }
}
function genGroups(rows,group,value,agg,opts={}){
  const isDateGroup=!!opts.isDateGroup,dateFmt=opts.dateFmt||'ymd';
  const g={};
