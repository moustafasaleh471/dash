function populateFilterControls(rows){
  const years = unique(rows.map(r=>String(r.year))).sort();
  const quarters = unique(rows.map(r=>String(r.quarter))).sort();
  const months = unique(rows.map(r=>String(r.month))).sort((a,b)=>monthIndex(a) - monthIndex(b));
  const depts = unique(rows.map(r=>String(r.dept))).sort((a,b)=>a.localeCompare(b));
  const names = unique(rows.map(r=>String(r.name))).sort((a,b)=>a.localeCompare(b));

  const buildMulti = (menuId, list, typeKey) => {
    const el = document.getElementById(menuId);
    if(!el) return;
    el.innerHTML = list.map(v=>`
      <label><input type="checkbox" value="${esc(v)}" onchange="onMultiFilterChange('${typeKey}')"> ${esc(v)}</label>
    `).join('');
  };

  buildMulti('menuYears', years, 'years');
  buildMulti('menuQuarters', quarters, 'quarters');
  buildMulti('menuMonths', months, 'months');
  buildMulti('menuDepts', depts, 'depts');
  buildMulti('menuNames', names, 'names');

  updateMultiLabels();
}

window.onMultiFilterChange = function(typeKey){
  const menuMap = { years: 'menuYears', quarters: 'menuQuarters', months: 'menuMonths', depts: 'menuDepts', names: 'menuNames' };
  const checked = [...document.querySelectorAll(`#${menuMap[typeKey]} input:checked`)].map(i=>i.value);
  APP.filters[typeKey] = checked;
  updateMultiLabels();
  applyGlobalFilters();
};

function updateMultiLabels(){
  const setLbl = (id, arr, defaultText) => {
    const el = document.getElementById(id);
    if(!el) return;
    if(!arr.length) el.textContent = defaultText;
    else if(arr.length === 1) el.textContent = arr[0];
    else el.textContent = `${arr.length} Selected`;
  };
  setLbl('lblYears', APP.filters.years, 'All Years');
  setLbl('lblQuarters', APP.filters.quarters, 'All Quarters');
  setLbl('lblMonths', APP.filters.months, 'All Months');
  setLbl('lblDepts', APP.filters.depts, 'All Departments');
  setLbl('lblNames', APP.filters.names, 'All Names');
}

window.applyGlobalFilters = function(){
  APP.filters.type = document.getElementById('filterType')?.value || 'ALL';

  if(!APP.rawRows || !APP.rawRows.length){
    renderCustomRatios();
    return;
  }

  let filtered = APP.rawRows.filter(r=>{
    if(APP.filters.years.length && !APP.filters.years.includes(String(r.year))) return false;
    if(APP.filters.quarters.length && !APP.filters.quarters.includes(String(r.quarter))) return false;
    if(APP.filters.months.length && !APP.filters.months.includes(String(r.month))) return false;
    if(APP.filters.depts.length && !APP.filters.depts.includes(String(r.dept))) return false;
    if(APP.filters.names.length && !APP.filters.names.includes(String(r.name))) return false;
    if(APP.filters.type!=='ALL' && String(r.prType)!==APP.filters.type) return false;
