<script>
'use strict';
const CALENDAR_MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
function monthIndex(mStr){
  if(!mStr) return 99;
  const sub = String(mStr).trim().substring(0,3).toLowerCase();
  const idx = CALENDAR_MONTHS.findIndex(m => m.toLowerCase() === sub);
  return idx !== -1 ? idx : 99;
}

function parseDateVal(raw){
  if(raw===null||raw===undefined||raw==='') return null;
  if(typeof raw === 'number'){
    if(raw > 1000 && raw < 100000) return new Date(Date.UTC(1899,11,30) + raw * 86400000);
    return new Date(raw);
  }
  const str = String(raw).trim();
  const d = new Date(str);
  if(!isNaN(d.getTime())) return d;
  const parts = str.split(/[-/]/);
  if(parts.length === 3){
    if(parts[0].length === 4) return new Date(parts[0], parts[1]-1, parts[2]);
    return new Date(parts[2], parts[1]-1, parts[0]);
  }
  return null;
}

function formatExcelDate(raw){
  const d = parseDateVal(raw);
  if(d && !isNaN(d.getTime())){
    return d.toISOString().split('T')[0];
  }
  return String(raw || '—');
}

