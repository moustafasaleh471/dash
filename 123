<!DOCTYPE html>
<html lang="en" data-theme="blue" data-font="tajawal" data-align="left">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Dynamic Procurement Executive Management Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
:root{--primary:#123c69;--primary-dark:#0d2b4a;--secondary:#2f80ed;--accent:#57a0ff;--bg-main:#eef2f6;--bg-card:#fff;--text-main:#1f2937;--text-muted:#6b7280;--border-color:#e4e9ef;--success:#14805e;--warning:#b7791f;--danger:#b42318;--info:#2563eb;--shadow:0 10px 30px rgba(15,23,42,.08);--radius:18px;--font-family:"Tajawal","Segoe UI",Tahoma,Arial,sans-serif;--circle-size:130px;--bar-track-h:22px;--chart-font-scale:1;--report-zoom:1;--container-w:1180px}
html[data-theme="emerald"]{--primary:#075e54;--primary-dark:#043f38;--secondary:#10b981;--accent:#34d399;--bg-main:#edf7f4;--border-color:#d8ebe5;--success:#047857;--warning:#a16207;--danger:#b42318;--info:#0f766e}
html[data-theme="dark"]{--primary:#172554;--primary-dark:#020617;--secondary:#60a5fa;--accent:#93c5fd;--bg-main:#0b1220;--bg-card:#111827;--text-main:#f3f4f6;--text-muted:#a7b0be;--border-color:#263244;--success:#34d399;--warning:#fbbf24;--danger:#fb7185;--info:#60a5fa;--shadow:0 10px 30px rgba(0,0,0,.3)}
html[data-font="tajawal"]{--font-family:"Tajawal","Segoe UI",Tahoma,Arial,sans-serif}html[data-font="cairo"]{--font-family:"Cairo","Trebuchet MS",Tahoma,Arial,sans-serif}html[data-font="arial"]{--font-family:Arial,Helvetica,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg-main);color:var(--text-main);font-family:var(--font-family);line-height:1.55;transition:background .2s,color .2s;zoom:var(--report-zoom)}.container{width:min(var(--container-w),calc(100% - 32px));margin:auto}.report-shell{padding-bottom:78px}.section{margin:28px 0;scroll-margin-top:86px}.section-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px}.section-title{display:flex;gap:12px;align-items:center;margin:0 0 18px;font-size:1.35rem;color:var(--primary)}.section-title .num{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:11px;background:var(--primary);color:#fff;font-size:.9rem;flex:0 0 auto}.muted{color:var(--text-muted)}.small{font-size:.86rem}.tiny{font-size:.76rem}.source-note{margin-top:12px;color:var(--text-muted);font-size:.82rem}.badge{display:inline-block;padding:4px 8px;border-radius:999px;font-size:.72rem;font-weight:800}.badge.source{background:color-mix(in srgb,var(--secondary) 14%,transparent);color:var(--secondary)}.badge.calc{background:color-mix(in srgb,var(--success) 14%,transparent);color:var(--success)}.badge.warn{background:color-mix(in srgb,var(--warning) 15%,transparent);color:var(--warning)}.badge.fail{background:color-mix(in srgb,var(--danger) 14%,transparent);color:var(--danger)}.badge.pass{background:color-mix(in srgb,var(--success) 14%,transparent);color:var(--success)}

/* Header & Editable Elements */
.hero{background:linear-gradient(135deg,var(--primary-dark),var(--primary) 55%,var(--secondary));color:#fff;padding:34px 0}
.hero-grid{display:grid;grid-template-columns:1.5fr .8fr;gap:28px;align-items:end}
.hero h1{margin:7px 0 8px;font-size:clamp(1.8rem,4vw,3rem);line-height:1.12}
.hero p{margin:6px 0;color:#e7eef7}
.hero-meta{display:grid;gap:9px}
.hero-meta div{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);padding:11px 13px;border-radius:12px}
.hero-meta strong{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.07em;color:#cfe1f5}
.hero-meta span{font-weight:800}

.editable-field{border-bottom:1.5px dashed rgba(255,255,255,.4);cursor:text;transition:.2s;padding-bottom:1px}
.editable-field:hover{border-bottom-color:#fff;background:rgba(255,255,255,.12);border-radius:4px}
.editable-field:focus{outline:none;border-bottom:2px solid var(--accent);background:rgba(255,255,255,.2);border-radius:4px}

.sticky-nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg-card) 94%,transparent);border-bottom:1px solid var(--border-color);backdrop-filter:blur(10px)}
.nav-inner{display:flex;gap:5px;overflow-x:auto;padding:9px 0;scrollbar-width:thin}
.nav-inner a{flex:0 0 auto;text-decoration:none;color:var(--text-main);font-size:.79rem;font-weight:800;padding:7px 9px;border-radius:9px}
.nav-inner a:hover{background:var(--primary);color:#fff}

.upload-panel{margin-top:-18px;position:relative;z-index:3}
.upload-card{background:var(--bg-card);border:1px solid var(--border-color);box-shadow:var(--shadow);border-radius:18px;padding:18px;display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center}
.drop-zone{border:1.5px dashed color-mix(in srgb,var(--secondary) 55%,var(--border-color));border-radius:14px;padding:14px 16px;transition:.2s;cursor:pointer}
.drop-zone.drag{background:color-mix(in srgb,var(--secondary) 8%,var(--bg-card));border-color:var(--secondary)}
.drop-zone strong{color:var(--primary)}
.load-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.btn{border:1px solid var(--border-color);background:var(--bg-card);color:var(--text-main);padding:9px 12px;border-radius:11px;font-family:var(--font-family);font-weight:800;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.btn.primary{background:var(--primary);border-color:var(--primary);color:#fff}
.btn.sm{padding:5px 9px;font-size:.75rem;border-radius:8px}
.btn.danger{background:var(--danger);color:#fff;border-color:var(--danger)}
.btn:hover{filter:brightness(.97)}
.load-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:9px;font-size:.78rem;color:var(--text-muted)}
.load-status{margin-top:10px;padding:10px 12px;border-radius:10px;border:1px solid var(--border-color);font-size:.82rem}
.load-status.ok{background:color-mix(in srgb,var(--success) 8%,var(--bg-card));color:var(--success)}
.load-status.error{background:color-mix(in srgb,var(--danger) 8%,var(--bg-card));color:var(--danger)}
.load-status.warn{background:color-mix(in srgb,var(--warning) 8%,var(--bg-card));color:var(--warning)}

/* Global Filters Bar & Multi-Select Dropdowns */
.filter-bar{margin-top:14px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:14px 18px;box-shadow:var(--shadow);display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
.filter-fields{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.filter-item{display:flex;align-items:center;gap:5px;font-size:.8rem;font-weight:800;color:var(--text-muted);position:relative}
.filter-drop-btn{padding:6px 11px;border:1px solid var(--border-color);background:var(--bg-main);color:var(--text-main);border-radius:8px;font-family:var(--font-family);font-weight:700;font-size:.78rem;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.filter-drop-btn:hover{border-color:var(--secondary)}
.filter-dropdown-menu{display:none;position:absolute;top:100%;left:0;z-index:100;margin-top:4px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:10px;box-shadow:0 10px 25px rgba(0,0,0,.15);padding:10px;min-width:180px;max-height:220px;overflow-y:auto}
.filter-dropdown-menu.show{display:block}
.filter-dropdown-menu label{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:.78rem;font-weight:600;color:var(--text-main);cursor:pointer}
.filter-dropdown-menu label:hover{color:var(--primary)}

.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.kpi{background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:17px;text-align:center;box-shadow:0 5px 18px rgba(15,23,42,.05)}.kpi .label{color:var(--text-muted);font-size:.76rem;font-weight:800;text-transform:uppercase;letter-spacing:.03em}.kpi .value{font-size:clamp(1.35rem,2.3vw,2rem);font-weight:900;color:var(--primary);line-height:1.15;margin:8px 0 5px}.kpi .sub{font-size:.76rem;color:var(--text-muted)}
.summary-grid,.insight-grid,.alert-grid,.source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.summary-box,.insight,.alert,.source-card,.trend-box,.chart-card,.circle-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:17px}.summary-box h3,.insight h3,.alert h3,.source-card h3,.trend-box h3,.chart-card h3{margin:0 0 8px;color:var(--primary)}.summary-box strong{font-size:1.12rem}.insight{border-left:4px solid var(--secondary)}.alert{border-left:4px solid var(--warning)}.alert.danger{border-left-color:var(--danger)}.alert.success{border-left-color:var(--success)}
.circle-group{display:grid;gap:20px}.circle-block{background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:18px}.circle-block h3{margin-top:0;color:var(--primary)}.circle-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.circle-row.split{grid-template-columns:repeat(2,minmax(0,1fr));max-width:650px}.circle-card{text-align:center}.circle{width:var(--circle-size);aspect-ratio:1;margin:0 auto 12px;border-radius:50%;display:grid;place-items:center;position:relative}.circle::after{content:"";position:absolute;inset:16px;background:var(--bg-card);border-radius:50%}.circle .circle-value{position:relative;z-index:2;font-weight:900;font-size:1.2rem;color:var(--primary)}.circle-label{font-weight:900}.circle-abs{color:var(--text-muted);font-size:.82rem}
.chart-card{overflow:hidden}.bar-chart{display:grid;gap:10px}.bar-row{display:grid;grid-template-columns:130px 1fr 150px;gap:10px;align-items:center}.bar-label{font-weight:800;font-size:calc(.82rem * var(--chart-font-scale));overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-track{height:var(--bar-track-h);background:color-mix(in srgb,var(--border-color) 68%,transparent);border-radius:999px;overflow:hidden;position:relative}.bar-fill{height:100%;min-width:0;border-radius:999px;background:linear-gradient(90deg,var(--primary),var(--secondary))}.bar-value{text-align:right;font-variant-numeric:tabular-nums;font-weight:800;font-size:calc(.8rem * var(--chart-font-scale))}.group-row{display:grid;grid-template-columns:130px 1fr;gap:10px;align-items:start;margin-bottom:14px}.group-bars{display:grid;gap:6px}.group-line{display:grid;grid-template-columns:80px 1fr 75px;gap:8px;align-items:center}.legend{display:flex;gap:14px;flex-wrap:wrap;margin:8px 0 14px;font-size:.82rem}.legend span::before{content:"";display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;background:var(--secondary)}.legend .normal::before{background:var(--success)}.bar-fill.normal{background:var(--success)}
.svg-wrap{width:100%;overflow-x:visible}.trend-svg{display:block;width:100%;height:auto}.svg-label{fill:var(--text-main);font-size:13px;font-weight:800}.svg-line{fill:none;stroke:var(--secondary);stroke-width:4}.svg-point{fill:var(--bg-card);stroke:var(--secondary);stroke-width:4}.svg-value{fill:var(--primary);font-size:13px;font-weight:900}
.table-wrap{overflow-x:auto;border:1px solid var(--border-color);border-radius:14px}.data-table{width:100%;border-collapse:collapse;min-width:760px;background:var(--bg-card)}.data-table th,.data-table td{padding:10px 11px;border-bottom:1px solid var(--border-color);font-size:.81rem;vertical-align:top}.data-table th{background:color-mix(in srgb,var(--primary) 8%,var(--bg-card));color:var(--primary);text-align:left;position:sticky;top:0;z-index:1}.data-table td.num{text-align:right;font-variant-numeric:tabular-nums}.status{font-weight:900}.status.above{color:var(--danger)}.status.below{color:var(--success)}
.trend-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:16px}.trend-box .trend-value{font-weight:900;font-size:1.45rem;color:var(--primary)}.trend-box .trend-change{font-weight:900}.down{color:var(--danger)}.up{color:var(--success)}.flat{color:var(--text-muted)}
.source-card .source-num{font-weight:900;color:var(--secondary);font-size:.76rem}.action-note{padding:12px 14px;border-radius:12px;background:color-mix(in srgb,var(--secondary) 8%,var(--bg-card));border:1px solid var(--border-color);margin-bottom:14px}

/* Custom Content Grid & Modals */
.custom-content-grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}
.custom-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:14px;padding:16px;position:relative}
.custom-card.note{border-left:5px solid var(--secondary)}
.custom-card.finding{border-left:5px solid var(--warning)}
.custom-card.action{border-left:5px solid var(--danger)}
.custom-card.kpi{border-left:5px solid var(--success)}
.custom-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.custom-card-title{font-weight:900;color:var(--primary);font-size:1.05rem;display:flex;align-items:center;gap:8px}
.custom-badge{font-size:.7rem;padding:2px 8px;border-radius:999px;background:color-mix(in srgb,var(--primary) 10%,transparent);color:var(--primary);font-weight:800}
.custom-meta{margin-top:8px;font-size:.8rem;color:var(--text-muted);font-weight:700}
.custom-modal-backdrop{display:none;position:fixed;inset:0;background:rgba(2,6,23,.5);z-index:250;backdrop-filter:blur(3px)}
.custom-modal-backdrop.show{display:flex;align-items:center;justify-content:center}
.custom-modal{background:var(--bg-card);border:1px solid var(--border-color);border-radius:18px;width:min(550px,94vw);max-height:90vh;overflow-y:auto;padding:24px;box-shadow:0 20px 40px rgba(0,0,0,.25)}
.form-group{margin-bottom:14px}.form-group label{display:block;font-size:.8rem;font-weight:800;color:var(--text-main);margin-bottom:6px}.form-group input,.form-group select,.form-group textarea{width:100%;padding:10px;border:1px solid var(--border-color);background:var(--bg-main);color:var(--text-main);border-radius:10px;font-family:var(--font-family);font-size:.85rem}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}

/* Report Builder & Dimensions Controls */
.builder-backdrop{display:none;position:fixed;inset:0;background:rgba(2,6,23,.28);z-index:190}.builder-backdrop.show{display:block}
.builder-panel{position:fixed;top:0;left:0;width:390px;max-width:92vw;height:100vh;background:var(--bg-card);border-right:1px solid var(--border-color);box-shadow:18px 0 44px rgba(15,23,42,.18);z-index:200;transform:translateX(-105%);transition:transform .24s ease;overflow:auto;padding:18px}.builder-panel.open{transform:translateX(0)}
.builder-head{position:sticky;top:-18px;z-index:3;background:var(--bg-card);padding:18px 0 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border-color);margin-bottom:12px}.builder-head h3{margin:0;color:var(--primary);font-size:1.1rem}
.builder-help{font-size:.76rem;color:var(--text-muted);border:1px solid var(--border-color);padding:10px 11px;border-radius:10px;margin-bottom:12px}
.builder-item{border:1px solid var(--border-color);border-radius:11px;padding:10px;margin:8px 0}.builder-item strong{display:block;font-size:.8rem;margin-bottom:7px}
.builder-row{display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center}
.builder-row select{width:100%;padding:8px;border:1px solid var(--border-color);background:var(--bg-main);color:var(--text-main);border-radius:8px;font:700 .75rem var(--font-family)}
.builder-row .apply-one{padding:8px 10px;font-size:.73rem;white-space:nowrap}
.builder-status{margin-top:9px;font-size:.73rem;color:var(--text-muted)}
.builder-custom{padding:12px;border:1px solid var(--border-color);border-radius:12px;background:var(--bg-card);line-height:1.65}
.builder-kpi-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.builder-kpi{padding:10px;border:1px solid var(--border-color);border-radius:10px;text-align:center}.builder-kpi .v{font-size:1.05rem;font-weight:900;color:var(--primary)}.builder-kpi .l{font-size:.68rem;color:var(--text-muted);font-weight:800}
.builder-bars{display:grid;gap:8px}.builder-bar{display:grid;grid-template-columns:105px 1fr 85px;gap:7px;align-items:center}.builder-bar .name{font-size:.72rem;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.builder-track{height:17px;background:color-mix(in srgb,var(--border-color) 70%,transparent);border-radius:999px;overflow:hidden}.builder-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--primary),var(--secondary))}.builder-fill.normal{background:var(--success)}.builder-bar .val{text-align:right;font-size:.72rem;font-weight:800}
.builder-svg{width:100%;overflow:hidden}.builder-svg svg{width:100%;min-width:0;height:auto;display:block}
.builder-table{overflow:auto}.builder-table table{width:100%;border-collapse:collapse;min-width:520px}.builder-table th,.builder-table td{padding:7px;border-bottom:1px solid var(--border-color);font-size:.72rem}.builder-table th{color:var(--primary);background:color-mix(in srgb,var(--primary) 7%,var(--bg-card));text-align:left}
.builder-donut{width:160px;height:160px;border-radius:50%;margin:5px auto 12px;position:relative}.builder-donut:after{content:"";position:absolute;inset:27px;background:var(--bg-card);border-radius:50%}
.builder-legend{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;font-size:.73rem;font-weight:800}.builder-legend i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:4px}
.builder-render{display:block;width:100%;grid-column:1/-1}.builder-render > *{width:100%;max-width:100%}
.builder-canvas{width:100%;display:flex;align-items:flex-start;overflow:visible;min-width:0}
.builder-visual{width:100%;max-width:100%;min-width:0;transform-origin:top left;transition:transform .15s ease}

/* Expanded Builder Controls CSS */
.builder-font-row,.builder-scale-row{display:grid;grid-template-columns:auto 1fr 48px;gap:7px;align-items:center;margin-top:7px;font-size:.71rem;color:var(--text-muted)}
.builder-font-row input,.builder-scale-row input{width:100%;accent-color:var(--secondary)}
.builder-font-value,.builder-scale-value{text-align:right;font-weight:900;color:var(--primary)}
.builder-actions-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:7px}
.builder-align-row{display:grid;grid-template-columns:auto 1fr;gap:7px;align-items:center;margin-top:7px;font-size:.71rem;color:var(--text-muted)}
.builder-align-row select{width:100%;padding:7px;border:1px solid var(--border-color);background:var(--bg-main);color:var(--text-main);border-radius:8px;font:700 .74rem var(--font-family)}
.builder-bold{display:flex;align-items:center;gap:5px;font-size:.72rem;font-weight:800;color:var(--text-muted)}
.builder-preview{margin-top:8px;border:1px dashed var(--border-color);border-radius:10px;padding:8px;background:color-mix(in srgb,var(--bg-main) 45%,var(--bg-card));max-height:240px;overflow:auto}
.builder-preview-title{font-size:.7rem;color:var(--text-muted);font-weight:800;margin-bottom:5px}
.builder-render.builder-bold,.builder-render.builder-bold *{font-weight:650!important}
.builder-color-row{display:grid;grid-template-columns:auto 1fr;gap:7px;align-items:center;margin-top:7px;font-size:.71rem;color:var(--text-muted)}
.builder-color-control{display:flex;align-items:center;gap:7px}
.builder-color-control input{width:42px;height:30px;padding:2px;border:1px solid var(--border-color);border-radius:7px;background:var(--bg-main)}
.builder-color-use{font-size:.7rem;color:var(--text-muted);display:flex;align-items:center;gap:4px}
.builder-render[data-rb-align="center"] .builder-canvas{justify-content:center!important}
.builder-render[data-rb-align="right"] .builder-canvas{justify-content:flex-end!important}
.builder-render[data-rb-align="left"] .builder-canvas{justify-content:flex-start!important}

/* Sizes Panel */
.sizes-panel{position:fixed;right:18px;bottom:78px;z-index:71;background:var(--bg-card);border:1px solid var(--border-color);box-shadow:var(--shadow);border-radius:14px;padding:16px;width:260px;display:none;font-family:var(--font-family)}
.sizes-panel.open{display:block}.sizes-panel h4{margin:0 0 12px;color:var(--primary);font-size:.92rem}.sizes-row{margin-bottom:12px}
.sizes-row label{display:flex;justify-content:space-between;font-size:.78rem;font-weight:800;color:var(--text-main);margin-bottom:4px}
.sizes-row input[type=range]{width:100%}.sizes-row .val{color:var(--secondary);font-variant-numeric:tabular-nums}
.sizes-reset{width:100%;margin-top:4px;border:1px solid var(--border-color);background:var(--bg-main);color:var(--text-main);padding:8px;border-radius:9px;font-family:var(--font-family);font-weight:800;cursor:pointer}

.floating-controls{position:fixed;right:18px;bottom:18px;z-index:70;display:flex;flex-direction:column;gap:8px}
.floating-controls button{border:1px solid var(--border-color);background:var(--bg-card);color:var(--text-main);box-shadow:var(--shadow);padding:10px 12px;border-radius:12px;font-family:var(--font-family);font-weight:900;cursor:pointer;min-width:138px;text-align:left}
.floating-controls button:hover{background:var(--primary);color:#fff}
.toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--primary-dark);color:#fff;padding:9px 13px;border-radius:10px;z-index:90;font-size:.8rem;transition:.2s}
.toast.show{opacity:1;transform:translate(-50%,0)}
.footer{padding:24px 0 40px;color:var(--text-muted);font-size:.8rem;text-align:center}

@page { size: A4 portrait; margin: 10mm 8mm; }
