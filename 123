window.saveCustomRatioFromModal = function(){
  const editId = document.getElementById('inpEditingRatioId')?.value;
  const name = document.getElementById('inpFormulaName')?.value.trim();
  const expr = document.getElementById('inpFormulaExpr')?.value.trim();
  const format = document.getElementById('inpFormulaFormat')?.value || 'raw';
  const visual = document.getElementById('inpFormulaVisual')?.value || 'kpi';
  const color = document.getElementById('inpFormulaColor')?.value || 'var(--secondary)';
  const desc = document.getElementById('inpFormulaDesc')?.value.trim();

  if(!name || !expr){
    toast('Please provide both metric name and formula expression.');
    return;
  }

  if(editId){
    const idx = userCustomRatios.findIndex(x => x.id === editId);
    if(idx !== -1){
      userCustomRatios[idx] = { id: editId, name, expr, format, visual, color, desc };
      toast('Custom ratio metric updated successfully.');
    }
  } else {
    userCustomRatios.push({ id: 'cr_' + Date.now(), name, expr, format, visual, color, desc });
    toast('Custom ratio metric added successfully.');
  }

  saveUserCustomRatiosStorage();
  closeFormulaModal();
  renderCustomRatios();
};

