    const raw=group?r[group]:null;
    let k,sortKey=null;
    if(group&&isDateGroup){
      k=genFormatDateLabel(raw,dateFmt);
      const d=parseDateVal(raw);
      sortKey=(d&&!isNaN(d.getTime()))?d.getTime():Number.POSITIVE_INFINITY;
    }else{
      k=group?String(raw??'Blank'):'All Records';
    }
    if(!g[k])g[k]={rows:[],sortKey};
    g[k].rows.push(r);
  });
  let arr=Object.entries(g).map(([label,o])=>({label,value:genAggregate(o.rows,value,agg),count:o.rows.length,sortKey:o.sortKey}));
  arr=isDateGroup?arr.sort((a,b)=>a.sortKey-b.sortKey):arr.sort((a,b)=>b.value-a.value);
  return arr.slice(0,20);
}
