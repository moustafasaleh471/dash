async function loadExcelFile(file){
  if(!file)return;
  showLoadStatus('warn','Reading and indexing '+esc(file.name)+'…');
  try{
    const buf=await file.arrayBuffer();
    const sheets=await parseXlsxArrayBuffer(buf);
    let finalSheets=sheets;

    // Generic workbook intake: use the first non-empty worksheet as-is.
    // The dashboard no longer requires procurement-specific sheet names/columns.
    const firstKey = Object.keys(sheets).find(k => Array.isArray(sheets[k]) && sheets[k].length) || Object.keys(sheets)[0];
    const matrix = sheets[firstKey] || [];
    const headers = (matrix[0] || []).map((h,i) => String(h ?? '').trim() || `Column_${i+1}`);
    const rows = matrix.slice(1).filter(r => Array.isArray(r) && r.some(v => v !== null && v !== undefined && String(v).trim() !== ''));
    APP.genericData = {sheetName:firstKey, headers, rows:rows.map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i] ?? null])))};

    // Also normalize the same matrix into the structured schema (KPIs, filters,
    // Report Builder, Custom Ratios). Without this, those features had no usable
    // rows to work with after an upload.
    const normalizedRows = extractRawRowsFromDataInput(matrix, file.name);
    APP.rawRows = normalizedRows;
    const structuredSheets = normalizedRows.length ? synthesizeSchemaFromRaw(normalizedRows, file.name) : JSON.parse(JSON.stringify(EMPTY_SHEETS));
    populateFilterControls(normalizedRows);
    const ok=setWorkbookData(structuredSheets,file.name,true);
    if(ok){
      APP.originalXlsxBytes=buf.slice(0);
      APP.originalXlsxName=file.name;
      toast('Excel loaded successfully: ' + file.name);
    }
  }catch(err){
    console.error(err);
    showLoadStatus('error','Could not load workbook: '+esc(err.message||String(err)));
  }
}

