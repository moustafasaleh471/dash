 function enhanceTrend(){var wrap=document.getElementById('quarterTrendSvg');var svg=wrap&&wrap.querySelector('svg.trend-svg');if(!svg||svg.dataset.hb)return;var m=APP.model;if(!m||!m.quarterly)return;var circles=Array.from(svg.querySelectorAll('circle.svg-point'));if(!circles.length)return;
  var max=Math.max.apply(null,m.quarterly.map(function(d){return d.total;}).concat([1])),T=20,ph=200,base=T+ph;var grid='';[0,.25,.5,.75,1].forEach(function(f){var y=base-f*ph;grid+='<line x1="60" x2="870" y1="'+y+'" y2="'+y+'" stroke="var(--border-color)" stroke-dasharray="4 4"/><text x="54" y="'+(y+4)+'" font-size="10" text-anchor="end" fill="var(--text-muted)">'+Math.round(max*f).toLocaleString()+'</text>';});
  svg.insertAdjacentHTML('afterbegin',grid);svg.insertAdjacentHTML('beforeend','<line class="hover-guide" y1="20" y2="220" stroke="var(--primary)" stroke-width="1.5" stroke-dasharray="5 4" style="display:none;pointer-events:none"/>');
  circles.forEach(function(c){c.classList.add('lh-pt');});
  var pts=circles.map(function(c,i){var d=m.quarterly[i]||{};var prev=i?m.quarterly[i-1]:null;var ch=prev&&prev.total?((d.total-prev.total)/prev.total*100):null;return {x:+c.getAttribute('cx'),html:'<strong>'+esc(periodLabel(d.year,d.quarter))+'</strong><br>Total PR: <b>'+fmtInt(d.total)+'</b><br>'+fmtInt(d.emergency)+' Emergency / '+fmtInt(d.normal)+' Normal'+(ch===null?'':'<br>vs prior: <b>'+(ch>=0?'↑ ':'↓ ')+Math.abs(ch).toFixed(2)+'%</b>')};});
  bindHover(svg,pts);}
 window.enhanceAll=function(){enhanceTrend();document.querySelectorAll('svg.dynamic-line-svg').forEach(function(svg){if(svg.dataset.hb)return;var cs=Array.from(svg.querySelectorAll('.lh-pt'));if(!cs.length)return;bindHover(svg,cs.map(function(c){return {x:+c.getAttribute('cx'),html:c.dataset.tooltip||''};}));});};
 var _rpt=window.renderPRTrend;window.renderPRTrend=function(){var r=_rpt.apply(this,arguments);try{enhanceTrend();}catch(e){console.warn(e);}return r;};
 var _ra=window.renderAll;window.renderAll=function(){var r=_ra.apply(this,arguments);try{decorateBlocks();enhanceAll();}catch(e){console.warn(e);}return r;};

 /* stale tooltip fix */
 document.addEventListener('mouseover',function(e){if(!e.target.closest||!e.target.closest('[data-tooltip],.hover-line-svg'))hideDynamicTooltip();});
 addEventListener('scroll',hideDynamicTooltip,{passive:true});

 /* safety net: re-decorate after any re-render */
 var t=null;new MutationObserver(function(ms){var real=ms.some(function(m){return Array.from(m.addedNodes).some(function(n){return !(n.classList&&n.classList.contains('block-tools'));});});if(!real)return;clearTimeout(t);t=setTimeout(function(){try{decorateBlocks();enhanceAll();}catch(e){}},300);}).observe(document.body,{childList:true,subtree:true});
 try{decorateBlocks();enhanceAll();}catch(e){console.warn(e);}
})();

</script>
<script>
/* ===== v4 extras: section close + sequential numbering, themes, filter cancel, editable point titles ===== */
(function(){
 var SEC_HIDDEN=new Set();
 var secs=function(){return Array.from(document.querySelectorAll('main section.section'));};
 var GENKEY={};try{Object.keys(GEN_SECTIONS).forEach(function(k){GENKEY[GEN_SECTIONS[k].target]=k;});}catch(e){}
 var isHiddenById=function(s){var k=GENKEY[s.id];return SEC_HIDDEN.has(s.id)||!!(k&&GEN_HIDDEN_SECTIONS[k]);};
 var secTitle=function(s){var t=s.querySelector('.section-title');if(!t)return s.id;var c=t.cloneNode(true);var n=c.querySelector('.num');if(n)n.remove();return c.textContent.trim();};
 var panelOpen=function(){var x=document.getElementById('dynamicSectionVisibility');return x&&x.style.display!=='none';};

 /* ---- sequential numbering of visible sections ---- */
 window.renumberSections=function(){
  var n=0,map={};
  secs().forEach(function(s){
   var numEl=s.querySelector('.section-title .num');if(!numEl)return;
   if(!numEl.dataset.orig)numEl.dataset.orig=numEl.textContent.trim();
   var hidden=s.classList.contains('sec-user-hidden')||s.classList.contains('section-hidden-by-user');
   if(/^\d+$/.test(numEl.dataset.orig)){
    if(hidden){map[s.id]=null;}else{n++;var t=(n<10?'0':'')+n;if(numEl.textContent!==t)numEl.textContent=t;map[s.id]=t;}
   }else map[s.id]=numEl.dataset.orig;
  });
  document.querySelectorAll('.sticky-nav a[href^="#"]').forEach(function(a){
   var id=a.getAttribute('href').slice(1),sec=document.getElementById(id);if(!sec)return;
   if(!a.dataset.orig)a.dataset.orig=a.textContent.trim();
   var hidden=sec.classList.contains('sec-user-hidden')||sec.classList.contains('section-hidden-by-user');
   a.style.display=hidden?'none':'';
   var m=/^(\d+)\s+(.*)$/.exec(a.dataset.orig);
   if(m&&map[id])a.textContent=map[id]+' '+m[2];
  });
  ['dynamicTargetSelect','quickSectionTarget','builderDynamicTarget'].forEach(function(id){
   var sel=document.getElementById(id);if(!sel)return;
   Array.from(sel.options).forEach(function(o){var g=GEN_SECTIONS[o.value];if(!g)return;var lab=map[g.target];o.textContent=(lab===null?o.value:(lab||o.value))+' · '+g.title+(lab===null?' (hidden)':'');});
  });
  return map;
 };
 window.applySecHidden=function(){secs().forEach(function(s){s.classList.toggle('sec-user-hidden',isHiddenById(s));});renumberSections();};
 window.toggleSecVisible=function(id,silent){
  var k=GENKEY[id];
  if(k){GEN_HIDDEN_SECTIONS[k]=!GEN_HIDDEN_SECTIONS[k];SEC_HIDDEN.delete(id);}
  else if(SEC_HIDDEN.has(id))SEC_HIDDEN.delete(id);else SEC_HIDDEN.add(id);
  var s=document.getElementById(id);if(s)s.classList.toggle('section-hidden-by-user',!!(k&&GEN_HIDDEN_SECTIONS[k]));
  applySecHidden();
  if(panelOpen())renderSectionVisibility();
  if(!silent&&s&&isHiddenById(s))snack('Section hidden: '+secTitle(s)+' — numbers re-sequenced','↶ Undo',function(){toggleSecVisible(id,true);});
 };
 window.hideSection=function(id){var s=document.getElementById(id);if(s&&!isHiddenById(s))toggleSecVisible(id);};
 var _tds=window.toggleDynamicSection;
 window.toggleDynamicSection=function(sec){var r=_tds?_tds.apply(this,arguments):0;applySecHidden();if(panelOpen())renderSectionVisibility();return r;};
 var _rdl=window.resetDynamicLayout;
 window.resetDynamicLayout=function(){SEC_HIDDEN.clear();var r=_rdl?_rdl.apply(this,arguments):0;Object.keys(GEN_HIDDEN_SECTIONS).forEach(function(k){delete GEN_HIDDEN_SECTIONS[k];});secs().forEach(function(s){s.classList.remove('section-hidden-by-user');});applySecHidden();if(panelOpen())renderSectionVisibility();toast('All sections are visible.');return r;};

 /* close button on every section */
 window.decorateSections=function(){secs().forEach(function(s){var card=s.querySelector(':scope > .section-card');if(!card||card.querySelector(':scope > .sec-close'))return;var b=document.createElement('button');b.type='button';b.className='sec-close no-print';b.title='Hide this section / إخفاء القسم';b.textContent='✕';b.dataset.sec=s.id;card.appendChild(b);});};
 document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('.sec-close');if(!b)return;e.preventDefault();e.stopPropagation();hideSection(b.dataset.sec);},true);

 /* sections panel: all sections, current numbers */
 var _rsv=window.renderSectionVisibility;
 window.renderSectionVisibility=function(){
  _rsv.apply(this,arguments);
  var box=document.getElementById('dynamicSectionVisibility');if(!box)return;
  var map=renumberSections();
  box.querySelectorAll('.section-visibility-row').forEach(function(r){var sp=r.firstElementChild;if(!sp)return;var m=/^(\d+) · (.*)$/.exec(sp.textContent);if(!m)return;var g=GEN_SECTIONS[m[1]];var lab=g?map[g.target]:null;sp.textContent=(lab||m[1])+' · '+m[2]+(g&&lab===null?' (hidden)':'');});
  var others=secs().filter(function(s){return !GENKEY[s.id];});
  var html='<div class="sv-other" style="margin-top:10px;border-top:1px solid var(--border-color);padding-top:8px"><strong style="color:var(--primary)">Other sections</strong>'+others.map(function(s){var h=isHiddenById(s),lab=map[s.id];return '<div class="section-visibility-row"><span>'+(lab?lab+' · ':'')+genEsc(secTitle(s))+(h?' (hidden)':'')+'</span><button type="button" data-id="'+s.id+'" onclick="toggleSecVisible(this.dataset.id,true)" title="'+(h?'Show':'Hide')+' section">'+(h?'👁️‍🗨️':'👁️')+'</button></div>';}).join('')+'</div>';
  var del=Array.from(box.children).find(function(c){return c.tagName==='DIV'&&/Deleted blocks/.test(c.textContent)&&c.style.borderTop;});
  if(del)del.insertAdjacentHTML('beforebegin',html);else box.insertAdjacentHTML('beforeend',html);
 };
 var _rgd=window.renderGenericDashboard;
 window.renderGenericDashboard=function(){var r=_rgd.apply(this,arguments);try{decorateSections();applySecHidden();}catch(e){console.warn(e);}return r;};
 var _ra=window.renderAll;
 window.renderAll=function(){var r=_ra.apply(this,arguments);try{decorateSections();applySecHidden();}catch(e){console.warn(e);}return r;};

 /* ---- editable point titles ---- */
 document.addEventListener('focusin',function(e){var t=e.target.closest&&e.target.closest('.dp-title');if(t)t.dataset.orig=t.textContent;});
 document.addEventListener('keydown',function(e){var t=e.target.closest&&e.target.closest('.dp-title');if(!t)return;if(e.key==='Enter'){e.preventDefault();t.blur();}else if(e.key==='Escape'){t.textContent=t.dataset.orig||t.textContent;t.blur();}});
 document.addEventListener('paste',function(e){var t=e.target.closest&&e.target.closest('.dp-title');if(!t)return;e.preventDefault();var tx=(e.clipboardData||window.clipboardData).getData('text').replace(/\s+/g,' ');document.execCommand('insertText',false,tx);});
 document.addEventListener('focusout',function(e){var t=e.target.closest&&e.target.closest('.dp-title');if(!t)return;var i=+t.dataset.idx,p=GEN_POINTS[i];if(!p)return;var v=t.textContent.trim();if(v===(t.dataset.orig||'').trim())return;pushHistory();if(v)p.title=v;else delete p.title;renderGenericDashboard();});

 /* ---- themes ---- */
 var TH=[['blue','Classic Blue','#2f80ed','#123c69','#eef2f6'],['emerald','Emerald','#10b981','#075e54','#edf7f4'],['ocean','Ocean','#0ea5e9','#0c4a6e','#eef7fc'],['sunset','Sunset','#f97316','#9a3412','#fff6ee'],['royal','Royal Purple','#8b5cf6','#4c1d95','#f4f0fe'],['rose','Rose','#f43f5e','#9f1239','#fff1f4'],['gold','Gold','#d97706','#713f12','#fefaf0'],['slate','Slate','#64748b','#334155','#f1f5f9'],['dark','Dark Blue','#60a5fa','#172554','#0b1220'],['midnight','Midnight','#818cf8','#312e81','#0f1020'],['graphite','Graphite','#f59e0b','#262626','#111111']];
 var root=document.documentElement;
 var CUSTOM=['--primary','--primary-dark','--secondary','--accent'];
 function clearCustom(){CUSTOM.forEach(function(v){root.style.removeProperty(v);});}
 function applyCustom(p,s){root.dataset.theme='custom';root.style.setProperty('--primary',p);root.style.setProperty('--primary-dark','color-mix(in srgb,'+p+' 65%,#000)');root.style.setProperty('--secondary',s);root.style.setProperty('--accent','color-mix(in srgb,'+s+' 70%,#fff)');}
 window.setTheme=function(t,quiet){clearCustom();root.dataset.theme=t;try{localStorage.setItem('pdb_theme',t);localStorage.removeItem('pdb_custom');}catch(e){}renderThemePicker();if(!quiet){var f=TH.filter(function(x){return x[0]===t;})[0];toast('Theme: '+(f?f[1]:t));}};
 window.setCustomTheme=function(){var p=document.getElementById('thP').value,s=document.getElementById('thS').value;applyCustom(p,s);try{localStorage.setItem('pdb_theme','custom');localStorage.setItem('pdb_custom',JSON.stringify([p,s]));}catch(e){}renderThemePicker(true);};
 function picker(){var x=document.getElementById('themePicker');if(!x){x=document.createElement('div');x.id='themePicker';x.className='no-print';document.body.appendChild(x);}return x;}
 window.renderThemePicker=function(keepInputs){var x=picker(),cur=root.dataset.theme;var cp=['#123c69','#2f80ed'];try{var c=JSON.parse(localStorage.getItem('pdb_custom')||'null');if(c)cp=c;}catch(e){}
  x.innerHTML='<div class="tp-head"><strong>🎨 Themes</strong><button type="button" onclick="closeThemePicker()">✕</button></div><div class="tp-grid">'+TH.map(function(t){return '<button type="button" class="tp-item'+(cur===t[0]?' on':'')+'" onclick="setTheme(\''+t[0]+'\')"><span class="tp-sw" style="background:linear-gradient(135deg,'+t[3]+' 0 45%,'+t[2]+' 45% 75%,'+t[4]+' 75%)"></span><span>'+t[1]+'</span></button>';}).join('')+'</div><div class="tp-custom'+(cur==='custom'?' on':'')+'"><span>Custom</span><label>Main <input id="thP" type="color" value="'+cp[0]+'" onchange="setCustomTheme()"></label><label>Accent <input id="thS" type="color" value="'+cp[1]+'" onchange="setCustomTheme()"></label></div>';};
 window.closeThemePicker=function(){var x=document.getElementById('themePicker');if(x)x.classList.remove('open');};
 window.toggleTheme=function(){var x=picker();renderThemePicker();x.classList.toggle('open');};
 document.addEventListener('mousedown',function(e){var x=document.getElementById('themePicker');if(x&&x.classList.contains('open')&&!e.target.closest('#themePicker')&&!(e.target.closest&&e.target.closest('[onclick*="toggleTheme"]')))x.classList.remove('open');});
 try{var st=localStorage.getItem('pdb_theme');if(st==='custom'){var c=JSON.parse(localStorage.getItem('pdb_custom')||'null');if(c)applyCustom(c[0],c[1]);}else if(st&&TH.some(function(t){return t[0]===st;}))root.dataset.theme=st;}catch(e){}

 /* ---- multi filter: chips, clear, close ---- */
 var FK=[['years','Year','menuYears'],['quarters','Quarter','menuQuarters'],['months','Month','menuMonths'],['depts','Dept','menuDepts'],['names','Name','menuNames']];
 var fb=document.querySelector('.filter-bar');
 if(fb){
  var chipBox=document.createElement('div');chipBox.id='filterChips';chipBox.className='filter-chips no-print';fb.appendChild(chipBox);
  var right=fb.lastElementChild&&fb.lastElementChild!==chipBox?fb.lastElementChild:fb.children[fb.children.length-2];
  if(right)right.insertAdjacentHTML('beforeend',' <button type="button" class="btn sm" onclick="closeMultiFilter()" title="Clear everything and hide this bar">✕ Cancel / Close Filters</button>');
 }
 window.renderFilterChips=function(){var box=document.getElementById('filterChips');if(!box||typeof APP==='undefined'||!APP.filters)return;var h='';FK.forEach(function(k){(APP.filters[k[0]]||[]).forEach(function(v){h+='<span class="dpf-chip">'+k[1]+': '+genEsc(v)+'<button type="button" data-k="'+k[0]+'" data-v="'+genEsc(v)+'" onclick="removeGlobalFilterValue(this.dataset.k,this.dataset.v)" title="Remove">✕</button></span>';});});
  if(APP.filters.type&&APP.filters.type!=='ALL')h+='<span class="dpf-chip">Type: '+genEsc(APP.filters.type)+'<button type="button" data-k="type" onclick="removeGlobalFilterValue(\'type\')" title="Remove">✕</button></span>';
  box.innerHTML=h;box.style.display=h?'flex':'none';};
 window.removeGlobalFilterValue=function(key,val){if(key==='type'){var s=document.getElementById('filterType');if(s)s.value='ALL';}else{APP.filters[key]=(APP.filters[key]||[]).filter(function(v){return v!==val;});var f=FK.filter(function(x){return x[0]===key;})[0];document.querySelectorAll('#'+f[2]+' input').forEach(function(i){if(i.value===val)i.checked=false;});updateMultiLabels();}applyGlobalFilters();};
 window.closeMultiFilter=function(){resetGlobalFilters();var b=document.querySelector('.filter-bar');if(b)b.classList.add('filter-closed');toast('Filters cancelled — use 🔍 Filters to bring the bar back.');};
 window.toggleFilterBar=function(){var b=document.querySelector('.filter-bar');if(!b)return;b.classList.toggle('filter-closed');if(!b.classList.contains('filter-closed'))b.scrollIntoView({block:'center',behavior:'smooth'});};
 var _uml=window.updateMultiLabels;if(_uml)window.updateMultiLabels=function(){var r=_uml.apply(this,arguments);renderFilterChips();return r;};
 var _agf=window.applyGlobalFilters;if(_agf)window.applyGlobalFilters=function(){var r=_agf.apply(this,arguments);renderFilterChips();return r;};
 var fc=document.querySelector('.floating-controls');
 if(fc){var cf=Array.from(fc.querySelectorAll('button')).filter(function(b){return /Clear Filters/.test(b.textContent);})[0];var nb=document.createElement('button');nb.type='button';nb.textContent='🔍 Filters (show/hide)';nb.onclick=toggleFilterBar;if(cf)cf.parentNode.insertBefore(nb,cf);else fc.appendChild(nb);}

 try{decorateSections();applySecHidden();renderFilterChips();}catch(e){console.warn(e);}
 var tm=null;new MutationObserver(function(){clearTimeout(tm);tm=setTimeout(function(){try{decorateSections();renumberSections();}catch(e){}},400);}).observe(document.querySelector('main')||document.body,{childList:true,subtree:true});
})();

</script>
